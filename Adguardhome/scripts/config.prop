# 注：redir_port 修改后需要重启生效；bypass 修改后最迟 5 秒生效
# AdGuardHome DNS 重定向端口
redir_port=54830

# DNS 劫持总开关（直通模式）
# 0=正常过滤；1=撤销全部 DNS 重定向与 DoT 拦截，系统改用网络下发的 DNS
# 适用于必须使用指定 DNS 的 WiFi（认证热点、校园网、企业内网等）
bypass=0

# 本机上游解析器（SmartDNS 等）的进程属主，命中则其 53 端口查询不再被重定向
# AdGuardHome 的上游指向本机解析器时必须配置：解析器发出的查询若被重定向回
# AdGuardHome，会与其上游形成回环，表现为解析大面积超时（缓存过期后集中爆发）
# 数值取自设备 /proc/<pid>/status 的 Uid/Gid 行；SmartDNS 模块以 chpst -u 0:3004 启动
# 只比对进程主组，App 的 3004 属附加组，因此不会被放行，其余流量的过滤不受影响
# IPv4 与 IPv6 的 53 都走这套规则：IPv6 过去是被整条 DROP，现在同样重定向进 AGH；
# 内核没有 IPv6 nat 表时改不动重定向，就退回拦截 IPv6:53（解析器仍然放行），不会裸放
# 853（DoT/DoQ）本版已完全不拦截，任何进程都能直连，也就不需要再为解析器开口子
# upstream_gid 留空则不生成豁免规则；修改后最迟 5 秒生效，会刷新一次网络
upstream_uid=0
upstream_gid=3004

# 代理订阅链接（在引号内填入你的订阅）
PROXY_URL=" "